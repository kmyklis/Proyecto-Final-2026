    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Menú móvil toggle
            const menuBtn = document.getElementById('menu-btn');
            const mobileMenu = document.getElementById('mobile-menu');
            if (menuBtn && mobileMenu) {
                menuBtn.addEventListener('click', () => {
                    mobileMenu.classList.toggle('hidden');
                });
            }

            // Modo Oscuro / Claro con persistencia
            const themeToggleBtn = document.getElementById('theme-toggle');
            const htmlElement = document.documentElement;

            // Comprobar preferencia guardada
            if (localStorage.getItem('geesat-theme') === 'dark' || (!localStorage.getItem('geesat-theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                htmlElement.classList.add('dark');
            } else {
                htmlElement.classList.remove('dark');
            }

            if (themeToggleBtn) {
                themeToggleBtn.addEventListener('click', () => {
                    if (htmlElement.classList.contains('dark')) {
                        htmlElement.classList.remove('dark');
                        localStorage.setItem('geesat-theme', 'light');
                    } else {
                        htmlElement.classList.add('dark');
                        localStorage.setItem('geesat-theme', 'dark');
                    }
                });
            }

            // Barra de progreso de scroll superior
            window.addEventListener('scroll', () => {
                const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
                const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
                const scrolled = (winScroll / height) * 100;
                const progressBar = document.getElementById('scroll-progress');
                if (progressBar) {
                    progressBar.style.width = scrolled + '%';
                }
            });

            // Resaltado dinámico (Scrollspy) de la navegación superior centralizada
            const sections = document.querySelectorAll('section[id]');
            const navLinks = document.querySelectorAll('.nav-link');

            function highlightNavOnScroll() {
                const scrollPos = window.scrollY + 150;

                sections.forEach(section => {
                    const sectionTop = section.offsetTop;
                    const sectionHeight = section.offsetHeight;
                    const sectionId = section.getAttribute('id');

                    if (scrollPos >= sectionTop && scrollPos < sectionTop + sectionHeight) {
                        navLinks.forEach(link => {
                            link.classList.remove('bg-geesatBlue', 'text-white', 'shadow-md', 'dark:bg-slate-700');
                            link.classList.add('text-slate-600', 'dark:text-slate-300');
                            if (link.getAttribute('data-section') === sectionId) {
                                link.classList.remove('text-slate-600', 'dark:text-slate-300');
                                link.classList.add('bg-geesatBlue', 'text-white', 'shadow-md', 'dark:bg-slate-700');
                            }
                        });
                    }
                });
            }

            window.addEventListener('scroll', highlightNavOnScroll);
            highlightNavOnScroll();
        });

        // Simulación de envío de formulario de salida a terreno
        function handleFormSubmit(event) {
            event.preventDefault();
            const successMsg = document.getElementById('form-success');
            const form = document.getElementById('terreno-form');
            if (successMsg && form) {
                successMsg.classList.remove('hidden');
                form.reset();
                setTimeout(() => {
                    successMsg.classList.add('hidden');
                }, 6000);
            }
        }
    </script>
