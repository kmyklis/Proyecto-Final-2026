    <section id="terreno" class="py-20 bg-slate-100 dark:bg-slate-900/50 border-y border-slate-200 dark:border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                <div>
                    <span class="text-xs font-semibold uppercase tracking-widest text-geesatBlue dark:text-geesatAccent bg-white dark:bg-slate-800 px-3 py-1 rounded-full shadow-sm">Gestión Práctica</span>
                    <h2 class="text-3xl font-bold mt-3 mb-4">Solicitud de Salida a Terreno</h2>
                    <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed mb-6">
                        Complete el formulario oficial para tramitar la autorización logística, transporte y seguros para las prácticas de campo de su curso asignado.
                    </p>
                    
                    <div class="space-y-4 mb-8 text-sm">
                        <div class="flex items-start gap-3">
                            <div class="w-8 h-8 rounded-full bg-blue-100 dark:bg-slate-800 text-geesatBlue dark:text-geesatAccent flex items-center justify-center font-bold flex-shrink-0 mt-0.5">1</div>
                            <p class="text-slate-600 dark:text-slate-300">Envíe la solicitud con al menos 15 días hábiles de anticipación a la fecha estimada.</p>
                        </div>
                        <div class="flex items-start gap-3">
                            <div class="w-8 h-8 rounded-full bg-blue-100 dark:bg-slate-800 text-geesatBlue dark:text-geesatAccent flex items-center justify-center font-bold flex-shrink-0 mt-0.5">2</div>
                            <p class="text-slate-600 dark:text-slate-300">Adjunte la nómina de estudiantes debidamente matriculados en el curso.</p>
                        </div>
                        <div class="flex items-start gap-3">
                            <div class="w-8 h-8 rounded-full bg-blue-100 dark:bg-slate-800 text-geesatBlue dark:text-geesatAccent flex items-center justify-center font-bold flex-shrink-0 mt-0.5">3</div>
                            <p class="text-slate-600 dark:text-slate-300">Recibirá la confirmación por correo una vez aprobada por la decanatura.</p>
                        </div>
                    </div>

                    <!-- Imagen ilustrativa -->
                    <div class="rounded-2xl overflow-hidden shadow-lg h-56">
                        <img src="https://images.unsplash.com/photo-1527489377706-5bf97e60c852?auto=format&fit=crop&q=80&w=800" alt="Salida a terreno" class="w-full h-full object-cover">
                    </div>
                </div>

                <!-- Formulario Interactivo -->
                <div class="bg-white dark:bg-slate-800 rounded-3xl p-8 shadow-xl border border-slate-200 dark:border-slate-700">
                    <h3 class="text-xl font-bold mb-6 text-slate-800 dark:text-white flex items-center gap-2">
                        <i class="fa-solid fa-file-lines text-geesatBlue"></i> Formulario de Solicitud
                    </h3>
                    
                    <form id="terreno-form" onsubmit="handleFormSubmit(event)" class="space-y-4">
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Destino del Terreno</label>
                            <input type="text" required placeholder="Ej. Yacimiento Geológico Norte / Reserva Andina" class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-geesatBlue">
                        </div>
                        
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Fecha de Salida</label>
                                <input type="date" required class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-geesatBlue">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Número de Estudiantes</label>
                                <input type="number" value="38" required class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-geesatBlue">
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Curso Asignado</label>
                            <input type="text" readonly value="Ingeniería Geológica - 4to Año" class="w-full px-4 py-3 rounded-xl bg-slate-100 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-700 text-sm text-slate-500 cursor-not-allowed">
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Objetivos de Aprendizaje</label>
                            <textarea rows="3" required placeholder="Describa brevemente la práctica..." class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-geesatBlue"></textarea>
                        </div>

                        <button type="submit" class="w-full bg-geesatBlue hover:bg-geesatBlueDark text-white font-bold py-3.5 rounded-xl shadow-md transition-all text-sm flex items-center justify-center gap-2">
                            <span>Enviar Solicitud Institucional</span>
                            <i class="fa-solid fa-paper-plane"></i>
                        </button>
                    </form>
                    
                    <div id="form-success" class="hidden mt-4 p-4 bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 text-emerald-700 dark:text-emerald-300 rounded-xl text-xs font-medium text-center">
                        <i class="fa-solid fa-circle-check mr-1"></i> ¡Solicitud enviada con éxito! Su decano asignado la revisará en breve.
                    </div>
                </div>
            </div>
        </div>
