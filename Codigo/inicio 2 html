<!-- ==========================================
     JAVASCRIPT
========================================== -->

<script>


/* ==========================================
   CALENDARIO
========================================== */

const diasCalendario =
    document.getElementById("diasCalendario");

const mesActual =
    document.getElementById("mesActual");

const fechaSalida =
    document.getElementById("fechaSalida");


let fechaCalendario =
    new Date(2026, 8, 1);



function crearCalendario() {


    diasCalendario.innerHTML = "";


    const año =
        fechaCalendario.getFullYear();


    const mes =
        fechaCalendario.getMonth();


    const primerDia =
        new Date(año, mes, 1)
        .getDay();


    const diasMes =
        new Date(
            año,
            mes + 1,
            0
        )
        .getDate();



    const nombresMeses = [

        "Enero",
        "Febrero",
        "Marzo",
        "Abril",
        "Mayo",
        "Junio",
        "Julio",
        "Agosto",
        "Septiembre",
        "Octubre",
        "Noviembre",
        "Diciembre"

    ];



    mesActual.textContent =
        nombresMeses[mes]
        + " "
        + año;



    let inicio =
        primerDia === 0
            ? 6
            : primerDia - 1;



    for (
        let i = 0;
        i < inicio;
        i++
    ) {


        const vacio =
            document.createElement("span");


        vacio.className =
            "dia vacio";


        diasCalendario.appendChild(
            vacio
        );

    }



    for (
        let dia = 1;
        dia <= diasMes;
        dia++
    ) {


        const elemento =
            document.createElement("span");


        elemento.className =
            "dia";


        elemento.textContent =
            dia;



        elemento.addEventListener(
            "click",
            () => {


                const mesNumero =
                    String(
                        mes + 1
                    )
                    .padStart(
                        2,
                        "0"
                    );


                const diaNumero =
                    String(dia)
                    .padStart(
                        2,
                        "0"
                    );


                fechaSalida.value =
                    `${año}-${mesNumero}-${diaNumero}`;



                document
                    .querySelectorAll(
                        ".dia.seleccionado"
                    )
                    .forEach(
                        elemento =>
                            elemento
                                .classList
                                .remove(
                                    "seleccionado"
                                )
                    );


                elemento
                    .classList
                    .add(
                        "seleccionado"
                    );

            }
        );



        diasCalendario
            .appendChild(
                elemento
            );

    }

}



crearCalendario();



document
    .getElementById("mesAnterior")
    .addEventListener(
        "click",
        () => {


            fechaCalendario
                .setMonth(
                    fechaCalendario
                        .getMonth() - 1
                );


            crearCalendario();

        }
    );



document
    .getElementById("mesSiguiente")
    .addEventListener(
        "click",
        () => {


            fechaCalendario
                .setMonth(
                    fechaCalendario
                        .getMonth() + 1
                );


            crearCalendario();

        }
    );



/* ==========================================
   PROGRAMAR SALIDA
========================================== */

document
    .getElementById("programar")
    .addEventListener(
        "click",
        () => {


            const fecha =
                document
                    .getElementById(
                        "fechaSalida"
                    )
                    .value;


            const horaSalida =
                document
                    .getElementById(
                        "horaSalida"
                    )
                    .value;


            const horaRegreso =
                document
                    .getElementById(
                        "horaRegreso"
                    )
                    .value;


            const lugar =
                document
                    .getElementById(
                        "lugarSalida"
                    )
                    .value;


            const descripcion =
                document
                    .getElementById(
                        "descripcionSalida"
                    )
                    .value;


            const resumen =
                document
                    .getElementById(
                        "resumen"
                    );



            if (
                !fecha ||
                !horaSalida ||
                !horaRegreso ||
                !lugar
            ) {


                alert(
                    "Completa la fecha, horario y lugar."
                );


                return;

            }



            resumen
                .classList
                .add(
                    "mostrar"
                );



            resumen.innerHTML = `

                <div class="resumen-icono">
                    ✓
                </div>

                <div>

                    <h3>
                        Salida programada
                    </h3>

                    <p>
                        📅 ${fecha}
                        &nbsp;&nbsp;
                        🕐 ${horaSalida}
                        -
                        ${horaRegreso}
                        &nbsp;&nbsp;
                        📍 ${lugar}
                    </p>

                    ${
                        descripcion
                        ?
                        `<small>${descripcion}</small>`
                        :
                        ""
                    }

                </div>

            `;

        }
    );



/* ==========================================
   MENÚ ACTIVO AUTOMÁTICO
========================================== */

const secciones =
    document.querySelectorAll(
        ".seccion"
    );


const opciones =
    document.querySelectorAll(
        ".opcion:not(.cerrar)"
    );



const observador =
    new IntersectionObserver(
        entradas => {


            entradas.forEach(
                entrada => {


                    if (
                        entrada.isIntersecting
                    ) {


                        opciones.forEach(
                            opcion =>
                                opcion
                                    .classList
                                    .remove(
                                        "activo"
                                    )
                        );



                        const activa =
                            document
                                .querySelector(
                                    `.opcion[href="#${entrada.target.id}"]`
                                );


                        if (activa) {

                            activa
                                .classList
                                .add(
                                    "activo"
                                );

                        }

                    }

                }
            );

        },
        {
            threshold: 0.45
        }
    );



secciones.forEach(
    seccion =>
        observador.observe(
            seccion
        )
);


</script>


